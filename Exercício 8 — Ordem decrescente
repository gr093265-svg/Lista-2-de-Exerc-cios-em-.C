#include <stdio.h>

int main() {
    int a, b, c, aux;

    printf("Digite tres numeros diferentes: ");
    scanf("%d %d %d", &a, &b, &c);

    // Colocamos o maior em "a" e o menor em "c" trocando de dois em dois
    if (a < b) {
        aux = a; a = b; b = aux;
    }
    if (a < c) {
        aux = a; a = c; c = aux;
    }
    if (b < c) {
        aux = b; b = c; c = aux;
    }

    printf("Ordem decrescente: %d, %d, %d\n", a, b, c);

    return 0;
}
